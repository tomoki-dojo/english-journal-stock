# VPS本番環境用の環境変数テンプレート。
# このファイルをコピーして .env.production を作り、実際の値を入れてVPS上に置く。
#   cp .env.production.example .env.production
# .env.production はgit管理対象外（.gitignoreで除外済み）。値は絶対にコミットしないこと。

# --- Supabase ---
# ビルド時にも埋め込まれるため、docker-compose.ymlのbuild.argsにも同じ値が渡る
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用。絶対にNEXT_PUBLIC_を付けない（クライアントに露出してしまう）
SUPABASE_SERVICE_ROLE_KEY=

# --- AI生成（コンテンツのオンデマンド生成機能。英語アプリMVPでは未実装のため現状未使用） ---
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# --- 例文音声（Pro/Premium限定機能）---
# Google CloudでText-to-Speech APIを有効化し、APIキーを発行して設定する。
# アプリ本体はこのキーを直接使わない（scripts/generate-expression-audio.tsでの
# バッチ生成時にのみ使用する、ローカル/CI専用のシークレット）。
GOOGLE_TTS_API_KEY=

# --- Stripe ---
# 数学アプリとは別のStripe商品・価格IDを使うこと。
# Pro月額680円・年額6,800円の2つのPriceを作成し、それぞれのPrice IDを設定する。
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_ANNUAL=
